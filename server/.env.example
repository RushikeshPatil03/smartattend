# ==============================================================================
# BACKEND CONFIGURATION (server/.env on Render / Local)
# Target Region: South Asia / Mumbai (ap-south-1)
# ==============================================================================
PORT=4000
NODE_ENV=production
HOST=0.0.0.0

# CORS & Domain
FRONTEND_URL=https://smartattend.app
CORS_ORIGINS=https://smartattend.app,https://www.smartattend.app,https://smartattend-api-lpbx.onrender.com
CORS_ORIGIN_PATTERNS=https://*.smartattend.app,https://*.pages.dev,https://*.onrender.com

# Supabase Mumbai Credentials (PostgreSQL + Realtime - ap-south-1)
# Copy from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-mumbai-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-mumbai-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-mumbai-supabase-anon-key

# Supabase Connection Pooler (Transaction Mode, Port 6543)
# Copy from: Supabase Dashboard -> Project Settings -> Database -> Connection Pooler
DATABASE_URL=postgresql://postgres.your-mumbai-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-mumbai-project-ref.supabase.co:5432/postgres

# Cryptographic Keys (min 32 characters)
JWT_SECRET=smart_attendance_jwt_secure_key_32chars_long_prod_ready
JWT_REFRESH_SECRET=smart_attendance_jwt_refresh_key_32chars_long_prod_ready
QR_SECRET=smart_attendance_qr_secret_rotation_key_32chars_long_prod
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_SECONDS=604800

# QR & Attendance Security
QR_TTL_SECONDS=3
QR_RECENT_HISTORY=8
QR_MAX_SEQUENCE_DRIFT=2
QR_MIN_ROTATION_SECONDS=3
QR_VERIFY_MAX_AGE_SECONDS=20
QR_MAX_TWO_STEP_GAP_SECONDS=45
SCAN_GRANT_TTL_MS=90000
MAX_LOCATION_ACCURACY_METERS=120
REQUIRE_FACE_VERIFICATION=false
DEFAULT_SESSION_RADIUS_METERS=50
