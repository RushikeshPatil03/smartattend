# ==============================================================================
# BACKEND CONFIGURATION (server/.env on Render / Local)
# ==============================================================================
PORT=4000
NODE_ENV=production
HOST=0.0.0.0

# CORS & Domain
FRONTEND_URL=https://smartattend.app
CORS_ORIGINS=https://smartattend.app,https://www.smartattend.app
CORS_ORIGIN_PATTERNS=https://*.smartattend.app,https://*.pages.dev,https://*.onrender.com

# Supabase (PostgreSQL + Realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# JWT & Crypto Secrets (min 32 characters)
JWT_SECRET=your-super-secret-jwt-signing-key-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-min-32-chars-long
QR_SECRET=your-super-secret-qr-signing-key-min-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_SECONDS=604800

# QR & Attendance Security
QR_TTL_SECONDS=3
QR_RECENT_HISTORY=8
QR_MAX_SEQUENCE_DRIFT=2
QR_MIN_ROTATION_SECONDS=3
QR_VERIFY_MAX_AGE_SECONDS=20
QR_MAX_TWO_STEP_GAP_SECONDS=45
SCAN_GRANT_TTL_MS=90000
MAX_LOCATION_ACCURACY_METERS=120
REQUIRE_FACE_VERIFICATION=false
DEFAULT_SESSION_RADIUS_METERS=50
